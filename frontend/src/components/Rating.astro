---
interface Props {
  bookId: string;
  initialRating?: number;
  isAuthenticated?: boolean;
}

const { bookId, initialRating, isAuthenticated = false } = Astro.props;
---

<section class="rating-widget" data-book-id={bookId} data-authenticated={isAuthenticated ? "true" : "false"}>
  <div class="rating-header">
    <h3>Votre note</h3>
    <p>
      {isAuthenticated 
        ? "Donnez une note de 1 à 5 étoiles à cette lecture." 
        : "Connectez-vous pour noter cette lecture."}
    </p>
  </div>

  <div class="stars-group" role="radiogroup" aria-label="Noter ce livre">
    {[1, 2, 3, 4, 5].map((star) => (
      <button
        type="button"
        class={`star-btn ${initialRating && star <= initialRating ? 'is-active' : ''}`}
        data-rating={star}
        aria-label={`${star} sur 5`}
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
          <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
        </svg>
      </button>
    ))}
  </div>

  <div class="rating-footer">
    <div class="rating-footer-main">
      <span class="rating-score" id="score-text">
        {initialRating ? `Votre note : ${initialRating}/5` : (isAuthenticated ? "Pas encore de note" : "Connexion requise")}
      </span>
      {isAuthenticated && (
        <button
          type="button"
          class={`delete-rating-btn ${!initialRating ? 'hidden' : ''}`}
          id="delete-rating-btn"
          title="Supprimer ma note"
          aria-label="Supprimer ma note"
        >
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="3 6 5 6 21 6"></polyline>
            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
          </svg>
          <span>Supprimer</span>
        </button>
      )}
    </div>
    {!isAuthenticated && (
      <p class="login-prompt">
        <a href="/login">Se connecter</a> pour enregistrer une note.
      </p>
    )}
    <span class="rating-feedback hidden" id="rating-feedback"></span>
  </div>
</section>

<script>
  async function submitRating(payload: { bookId: string; rating: number }) {
    const requestBody = {
      book_id: String(payload.bookId),
      note: Number(payload.rating),
    };

    console.log('[Rating] Envoi de la requête PUT /api/readings avec le body :', requestBody);

    const response = await fetch('/api/readings', {
      method: 'PUT',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(requestBody),
    });

    let data: any;
    try {
      data = await response.json();
    } catch {
      data = { erreur: `Erreur serveur (${response.status})` };
    }

    console.log('[Rating] Réponse reçue de PUT /api/readings :', response.status, data);

    if (!response.ok) {
      throw new Error(data.erreur || data.message || "Erreur lors de l'enregistrement de la note.");
    }

    return {
      success: true,
      data,
    };
  }

  async function deleteRating(bookId: string) {
    console.log(`[Rating] Envoi de la requête DELETE /api/readings/${bookId}`);

    const response = await fetch(`/api/readings/${encodeURIComponent(bookId)}`, {
      method: 'DELETE',
    });

    let data: any;
    try {
      data = await response.json();
    } catch {
      data = { erreur: `Erreur serveur (${response.status})` };
    }

    console.log(`[Rating] Réponse reçue de DELETE /api/readings/${bookId} :`, response.status, data);

    if (!response.ok) {
      throw new Error(data.erreur || data.message || "Erreur lors de la suppression de la note.");
    }

    return {
      success: true,
      data,
    };
  }

  function initRatingWidgets() {
    const widgets = document.querySelectorAll<HTMLElement>(".rating-widget");

    widgets.forEach((widget) => {
      const isAuth = widget.dataset.authenticated === "true";
      const bookId = widget.dataset.bookId || widget.getAttribute("data-book-id") || "";
      const stars = widget.querySelectorAll<HTMLButtonElement>(".star-btn");
      const scoreText = widget.querySelector<HTMLSpanElement>("#score-text");
      const feedback = widget.querySelector<HTMLSpanElement>("#rating-feedback");
      const deleteBtn = widget.querySelector<HTMLButtonElement>("#delete-rating-btn");

      let currentRating = 0;
      const activeStars = widget.querySelectorAll<HTMLButtonElement>(".star-btn.is-active");
      if (activeStars.length > 0) {
        currentRating = Number(activeStars[activeStars.length - 1].dataset.rating) || 0;
      }

      let isSubmitting = false;
      let feedbackTimer: number | null = null;

      const clearFeedback = () => {
        if (feedbackTimer) {
          clearTimeout(feedbackTimer);
          feedbackTimer = null;
        }
        if (feedback) {
          feedback.textContent = "";
          feedback.className = "rating-feedback hidden";
        }
      };

      const showFeedback = (msg: string, type: 'success' | 'error' | 'pending') => {
        if (!feedback) return;
        if (feedbackTimer) {
          clearTimeout(feedbackTimer);
          feedbackTimer = null;
        }
        feedback.textContent = msg;
        feedback.className = `rating-feedback ${type}`;

        if (type !== 'pending') {
          feedbackTimer = window.setTimeout(() => {
            if (feedback.textContent === msg) {
              feedback.textContent = "";
              feedback.className = "rating-feedback hidden";
            }
            feedbackTimer = null;
          }, 3500);
        }
      };

      const highlightStars = (count: number) => {
        stars.forEach((star) => {
          const value = Number(star.dataset.rating);
          star.classList.toggle("hovered", value <= count);
        });
      };

      const resetStarStyles = () => {
        stars.forEach((star) => {
          star.classList.remove("hovered");
          const value = Number(star.dataset.rating);
          star.classList.toggle("is-active", value <= currentRating);
        });
      };

      stars.forEach((star) => {
        star.addEventListener("mouseenter", () => {
          if (!isSubmitting) {
            const val = Number(star.dataset.rating);
            highlightStars(val);
          }
        });

        star.addEventListener("click", async () => {
          if (isSubmitting) return;

          const selectedRating = parseInt(star.dataset.rating || "0", 10);

          if (!isAuth) {
            showFeedback("Vous devez être connecté pour noter un livre.", "error");
            return;
          }

          isSubmitting = true;
          stars.forEach((btn) => (btn.disabled = true));
          if (deleteBtn) deleteBtn.disabled = true;

          showFeedback("Enregistrement...", "pending");

          try {
            const res = await submitRating({ bookId, rating: selectedRating });

            if (res.success) {
              currentRating = selectedRating;
              resetStarStyles();

              if (scoreText) {
                scoreText.textContent = `Votre note : ${currentRating}/5`;
              }

              if (deleteBtn) {
                deleteBtn.classList.remove("hidden");
              }

              showFeedback("Note enregistrée !", "success");

              window.dispatchEvent(
                new CustomEvent("reading-updated", {
                  detail: { bookId, isRead: true, note: currentRating, source: 'rating' },
                })
              );
            }
          } catch (err: any) {
            showFeedback(err.message || "Erreur lors de l'enregistrement.", "error");
          } finally {
            isSubmitting = false;
            stars.forEach((btn) => (btn.disabled = false));
            if (deleteBtn) deleteBtn.disabled = false;
          }
        });
      });

      if (deleteBtn) {
        deleteBtn.addEventListener("click", async () => {
          if (isSubmitting || !isAuth) return;

          isSubmitting = true;
          stars.forEach((btn) => (btn.disabled = true));
          deleteBtn.disabled = true;

          showFeedback("Suppression de la note...", "pending");

          try {
            const res = await deleteRating(bookId);

            if (res.success) {
              currentRating = 0;
              resetStarStyles();

              if (scoreText) {
                scoreText.textContent = "Pas encore de note";
              }

              deleteBtn.classList.add("hidden");

              showFeedback("Note supprimée avec succès !", "success");

              window.dispatchEvent(
                new CustomEvent("reading-updated", {
                  detail: { bookId, isRead: false, note: null, source: 'rating' },
                })
              );
            }
          } catch (err: any) {
            showFeedback(err.message || "Erreur lors de la suppression de la note.", "error");
          } finally {
            isSubmitting = false;
            stars.forEach((btn) => (btn.disabled = false));
            deleteBtn.disabled = false;
          }
        });
      }

      window.addEventListener("reading-updated", ((e: CustomEvent) => {
        if (e.detail?.bookId === bookId) {
          if (e.detail.source !== 'rating') {
            clearFeedback();
          }

          if (!e.detail.isRead) {
            currentRating = 0;
            resetStarStyles();
            if (scoreText) {
              scoreText.textContent = "Pas encore de note";
            }
            if (deleteBtn) {
              deleteBtn.classList.add("hidden");
            }
          }
        }
      }) as EventListener);

      widget.addEventListener("mouseleave", () => {
        if (!isSubmitting) {
          resetStarStyles();
        }
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initRatingWidgets);
  } else {
    initRatingWidgets();
  }
</script>

<style>
  .rating-widget {
    background-color: #f8fafc;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: 1rem;
    margin-top: 1rem;
  }

  .rating-header h3 {
    font-size: 0.95rem;
    margin: 0 0 0.2rem 0;
    color: var(--text-primary);
  }

  .rating-header p {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 0 0 0.75rem 0;
  }

  .stars-group {
    display: flex;
    gap: 0.25rem;
    margin-bottom: 0.5rem;
  }

  .star-btn {
    background: none;
    border: none;
    padding: 0.15rem;
    cursor: pointer;
    color: #cbd5e1;
    transition: color 0.15s ease, transform 0.1s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .star-btn:hover:not(:disabled) {
    transform: scale(1.15);
  }

  .star-btn.is-active,
  .star-btn.hovered {
    color: #f59e0b;
  }

  .star-btn:disabled {
    cursor: not-allowed;
    opacity: 0.7;
  }

  .rating-footer {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.8rem;
  }

  .rating-footer-main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .rating-score {
    font-weight: 500;
    color: var(--text-secondary);
  }

  .delete-rating-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: transparent;
    border: 1px solid #fca5a5;
    color: #dc2626;
    border-radius: 4px;
    padding: 0.2rem 0.45rem;
    font-size: 0.75rem;
    cursor: pointer;
    line-height: 1;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .delete-rating-btn:hover:not(:disabled) {
    background-color: #fee2e2;
    border-color: #ef4444;
  }

  .delete-rating-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .delete-rating-btn.hidden {
    display: none;
  }

  .rating-feedback {
    font-weight: 500;
    animation: fadeIn 0.2s ease-out;
  }

  .rating-feedback.hidden { display: none; }
  .rating-feedback.pending { color: var(--text-muted); }
  .rating-feedback.success { color: #16a34a; }
  .rating-feedback.error { color: #dc2626; }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .login-prompt {
    font-size: 0.8rem;
    margin: 0.25rem 0 0 0;
    color: var(--text-muted);
  }

  .login-prompt a {
    color: #2563eb;
    text-decoration: underline;
  }
</style>