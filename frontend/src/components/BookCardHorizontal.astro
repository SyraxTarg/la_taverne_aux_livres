---
// src/components/BookCardHorizontal.astro
import type { ApiBook } from '../data/books';

interface Props {
  book: ApiBook;
}

const { book } = Astro.props;

const authorsLabel = book.authors && book.authors.length > 0
  ? book.authors.map((a) => a.name).join(', ')
  : 'Auteur inconnu';

const year = book.published_date ? book.published_date.slice(0, 4) : null;
const coverUrl = book.image_url ? book.image_url.replace(/^http:\/\//i, 'https://') : null;
---

<article class="book-card-horizontal">
  <a href={`/books/${book.id}`} class="card-link">
    <div class="image-wrapper">
      {coverUrl ? (
        <img src={coverUrl} alt={book.title} loading="lazy" />
      ) : (
        <div class="no-cover">
          <span class="no-cover-icon">📖</span>
          <span class="no-cover-text">Sans image</span>
        </div>
      )}
    </div>

    <div class="card-body">
      <header class="card-header">
        <div class="header-top">
          <span class="meta-author">{authorsLabel} {year && `• ${year}`}</span>
          {book.average_rating > 0 && (
            <div class="rating-box">
              <span class="star filled">★</span>
              <span class="rating-text">{book.average_rating}/5</span>
            </div>
          )}
        </div>
        <h3 class="card-title">{book.title}</h3>
      </header>

      <p class="summary">
        {book.description || "Aucune description détaillée disponible pour cet enregistrement."}
      </p>

      <footer class="card-footer">
        <div class="categories">
          {book.categories && book.categories.length > 0 ? (
            book.categories.map((c) => (
              <span class="category-tag">{c.name}</span>
            ))
          ) : (
            <span class="category-tag muted">Général</span>
          )}
        </div>

        {book.page_count > 0 && (
          <span class="page-count">{book.page_count} pages</span>
        )}
      </footer>
    </div>
  </a>
</article>

<style>
  .book-card-horizontal {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    overflow: hidden;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .book-card-horizontal:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 16px -4px rgba(0, 0, 0, 0.06), 0 4px 6px -2px rgba(0, 0, 0, 0.03);
    border-color: var(--border-hover);
  }

  .card-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    min-height: 150px;
  }

  .image-wrapper {
    position: relative;
    width: 120px;
    min-width: 120px;
    background-color: #f1f5f9;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .no-cover {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    color: var(--text-muted);
  }

  .no-cover-icon {
    font-size: 1.8rem;
  }

  .no-cover-text {
    font-size: 0.7rem;
    font-weight: 500;
  }

  .card-body {
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex-grow: 1;
    gap: 0.6rem;
  }

  .header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.2rem;
  }

  .meta-author {
    font-size: 0.8rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card-title {
    font-size: 1.15rem;
    margin: 0;
    line-height: 1.3;
  }

  .rating-box {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    white-space: nowrap;
  }

  .star.filled {
    color: #f59e0b;
    font-size: 0.85rem;
  }

  .rating-text {
    font-size: 0.8rem;
    color: var(--text-secondary);
    font-weight: 600;
  }

  .summary {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding-top: 0.4rem;
  }

  .categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .category-tag {
    font-size: 0.72rem;
    background-color: var(--bg-hover);
    color: var(--text-secondary);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    border: 1px solid var(--border-color);
  }

  .category-tag.muted {
    opacity: 0.6;
  }

  .page-count {
    font-size: 0.75rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  @media (max-width: 580px) {
    .card-link {
      flex-direction: column;
    }
    .image-wrapper {
      width: 100%;
      height: 160px;
    }
  }
</style>