---
import type { ApiCommentWithReplies } from '../data/books';
import { API_URL } from 'astro:env/server';

interface Props {
  bookId: string;
}

const { bookId } = Astro.props;
const token = Astro.cookies.get('auth_token')?.value;
const isAuthenticated = !!token;

let currentUserId: number | null = null;
let currentUserEmail: string | null = null;

if (token) {
  try {
    const userEndpoint = API_URL.endsWith('/api')
      ? `${API_URL}/users/me`
      : `${API_URL}/api/users/me`;
    const userRes = await fetch(userEndpoint, {
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${token}`,
      },
    });
    if (userRes.ok) {
      const userData = await userRes.json();
      currentUserId = userData.id;
      currentUserEmail = userData.email;
    }
  } catch (err) {
    console.error("Erreur récupération utilisateur connecté :", err);
  }
}

let comments: ApiCommentWithReplies[] = [];

try {
  const baseUrl = API_URL.endsWith('/api') ? API_URL : `${API_URL}/api`;
  const response = await fetch(`${baseUrl}/books/${bookId}/comments`);
  if (response.ok) {
    comments = await response.json();
  }
} catch (error) {
  console.error("Erreur lors de la récupération des commentaires :", error);
}

const totalComments = comments.reduce((acc, c) => acc + 1 + (c.reponses?.length || 0), 0);

function formatDate(dateStr: string) {
  try {
    const d = new Date(dateStr);
    if (isNaN(d.getTime())) return dateStr;
    return d.toLocaleDateString('fr-FR', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    });
  } catch {
    return dateStr;
  }
}
---

<section
  class="comments-block"
  data-book-id={bookId}
  data-authenticated={isAuthenticated ? "true" : "false"}
  data-current-user-id={currentUserId ?? ""}
>
  <div class="block-header">
    <h2>Commentaires (<span id="comments-count">{totalComments}</span>)</h2>
    <p>Partagez votre avis de lecture et échangez avec les autres lecteurs.</p>
  </div>

  <form id="comment-form" class="comment-form">
    <div class="field">
      <label for="content-input">Votre commentaire</label>
      <textarea
        id="content-input"
        name="content"
        rows="3"
        placeholder={isAuthenticated ? "Donnez vos impressions sur ce livre..." : "Connectez-vous pour laisser un commentaire..."}
        required
        disabled={!isAuthenticated}
      ></textarea>
    </div>

    <div class="form-actions">
      <button type="submit" id="submit-btn" disabled={!isAuthenticated}>
        Envoyer mon commentaire
      </button>
      {!isAuthenticated && (
        <a href="/login" class="login-hint">Connexion requise pour commenter</a>
      )}
      <span id="status-message" class="status-box hidden"></span>
    </div>
  </form>

  <div class="comments-list" id="comments-list">
    {comments.length === 0 ? (
      <p class="empty-text" id="empty-state">
        Aucun commentaire pour le moment. Soyez le premier à donner votre avis !
      </p>
    ) : (
      comments.map((item) => {
        const isOwner = currentUserId !== null && item.user_id === currentUserId;
        return (
          <div class="comment-thread" data-thread-id={item.id}>
            <article class="comment-card level-1" data-comment-id={item.id} data-user-id={item.user_id}>
              <div class="comment-top">
                <div class="author-badge">
                  <span class="avatar-icon">👤</span>
                  <strong>{isOwner ? "Vous" : `Lecteur #${item.user_id}`}</strong>
                </div>
                <div class="comment-top-right">
                  <time datetime={item.created_at}>{formatDate(item.created_at)}</time>
                  {isOwner && (
                    <div class="comment-menu-wrapper">
                      <button
                        type="button"
                        class="comment-menu-btn"
                        aria-label="Options du commentaire"
                        title="Options"
                      >
                        ⋯
                      </button>
                      <div class="comment-menu-dropdown hidden">
                        <button type="button" class="menu-item action-edit">
                          ✏️ Modifier
                        </button>
                        <button type="button" class="menu-item action-delete">
                          🗑️ Supprimer
                        </button>
                      </div>
                    </div>
                  )}
                </div>
              </div>
              <p class="comment-body">{item.content}</p>

              <div class="comment-actions">
                <button
                  type="button"
                  class="reply-trigger-btn"
                  data-parent-id={item.id}
                  title="Répondre à ce commentaire"
                >
                  <span class="reply-icon">↩</span> Répondre
                </button>
              </div>

              <form class="reply-form hidden" data-parent-id={item.id}>
                <div class="field">
                  <textarea
                    class="reply-input"
                    name="content"
                    rows="2"
                    placeholder={isAuthenticated ? "Écrivez votre réponse..." : "Connectez-vous pour répondre..."}
                    required
                    disabled={!isAuthenticated}
                  ></textarea>
                </div>
                <div class="reply-actions">
                  <button type="submit" class="reply-submit-btn" disabled={!isAuthenticated}>
                    Envoyer la réponse
                  </button>
                  <button type="button" class="reply-cancel-btn">
                    Annuler
                  </button>
                  {!isAuthenticated && (
                    <a href="/login" class="login-hint">Connexion requise</a>
                  )}
                  <span class="reply-status-msg status-box hidden"></span>
                </div>
              </form>
            </article>

            <div class="replies-list" data-parent-id={item.id}>
              {item.reponses && item.reponses.length > 0 && item.reponses.map((rep) => {
                const isRepOwner = currentUserId !== null && rep.user_id === currentUserId;
                return (
                  <article class="comment-card level-2" data-comment-id={rep.id} data-user-id={rep.user_id}>
                    <div class="comment-top">
                      <div class="author-badge">
                        <span class="reply-tag">↳ Réponse</span>
                        <strong>{isRepOwner ? "Vous" : `Lecteur #${rep.user_id}`}</strong>
                      </div>
                      <div class="comment-top-right">
                        <time datetime={rep.created_at}>{formatDate(rep.created_at)}</time>
                        {isRepOwner && (
                          <div class="comment-menu-wrapper">
                            <button
                              type="button"
                              class="comment-menu-btn"
                              aria-label="Options de la réponse"
                              title="Options"
                            >
                              ⋯
                            </button>
                            <div class="comment-menu-dropdown hidden">
                              <button type="button" class="menu-item action-edit">
                                ✏️ Modifier
                              </button>
                              <button type="button" class="menu-item action-delete">
                                🗑️ Supprimer
                              </button>
                            </div>
                          </div>
                        )}
                      </div>
                    </div>
                    <p class="comment-body">{rep.content}</p>
                  </article>
                );
              })}
            </div>
          </div>
        );
      })
    )}
  </div>
</section>

<script>
  function escapeHtml(text: string): string {
    const div = document.createElement("div");
    div.textContent = text;
    return div.innerHTML;
  }

  function updateCommentsCount(delta: number) {
    const countEl = document.getElementById("comments-count");
    if (countEl) {
      const current = parseInt(countEl.textContent || "0", 10) || 0;
      countEl.textContent = String(Math.max(0, current + delta));
    }
  }

  const container = document.querySelector(".comments-block") as HTMLElement;
  const bookId = container?.dataset.bookId || "";
  const isAuthenticated = container?.dataset.authenticated === "true";
  const currentUserId = container?.dataset.currentUserId ? Number(container.dataset.currentUserId) : null;

  const form = document.getElementById("comment-form") as HTMLFormElement;
  const list = document.getElementById("comments-list") as HTMLDivElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const statusMsg = document.getElementById("status-message") as HTMLSpanElement;
  const contentInput = document.getElementById("content-input") as HTMLTextAreaElement;

  // Fermer les menus d'options au clic en dehors
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest(".comment-menu-wrapper")) {
      document.querySelectorAll(".comment-menu-dropdown:not(.hidden)").forEach((d) => {
        d.classList.add("hidden");
      });
    }
  });

  function attachMenuListeners(cardEl: HTMLElement) {
    const menuBtn = cardEl.querySelector(".comment-menu-btn") as HTMLButtonElement;
    const menuDropdown = cardEl.querySelector(".comment-menu-dropdown") as HTMLElement;
    const editBtn = cardEl.querySelector(".action-edit") as HTMLButtonElement;
    const deleteBtn = cardEl.querySelector(".action-delete") as HTMLButtonElement;

    if (!menuBtn || !menuDropdown) return;

    menuBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      const isCurrentlyHidden = menuDropdown.classList.contains("hidden");
      document.querySelectorAll(".comment-menu-dropdown:not(.hidden)").forEach((d) => {
        d.classList.add("hidden");
      });
      if (isCurrentlyHidden) {
        menuDropdown.classList.remove("hidden");
      }
    });

    editBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      menuDropdown.classList.add("hidden");

      const commentId = cardEl.dataset.commentId;
      if (!commentId) return;

      const bodyEl = cardEl.querySelector(".comment-body") as HTMLElement;
      if (!bodyEl || cardEl.querySelector(".comment-edit-box")) return;

      const originalText = bodyEl.textContent || "";
      bodyEl.style.display = "none";

      const editBox = document.createElement("div");
      editBox.className = "comment-edit-box";
      editBox.innerHTML = `
        <textarea class="edit-textarea" rows="2" required></textarea>
        <div class="edit-actions">
          <button type="button" class="edit-save-btn">Enregistrer</button>
          <button type="button" class="edit-cancel-btn">Annuler</button>
          <span class="edit-status-msg status-box hidden"></span>
        </div>
      `;

      const editTextarea = editBox.querySelector(".edit-textarea") as HTMLTextAreaElement;
      editTextarea.value = originalText;
      bodyEl.after(editBox);
      editTextarea.focus();

      const saveBtn = editBox.querySelector(".edit-save-btn") as HTMLButtonElement;
      const cancelBtn = editBox.querySelector(".edit-cancel-btn") as HTMLButtonElement;
      const editStatus = editBox.querySelector(".edit-status-msg") as HTMLSpanElement;

      cancelBtn.addEventListener("click", () => {
        editBox.remove();
        bodyEl.style.display = "";
      });

      saveBtn.addEventListener("click", async () => {
        const newText = editTextarea.value.trim();
        if (!newText) {
          editStatus.textContent = "Le contenu ne peut pas être vide.";
          editStatus.className = "edit-status-msg status-box error";
          return;
        }

        if (newText === originalText) {
          editBox.remove();
          bodyEl.style.display = "";
          return;
        }

        saveBtn.disabled = true;
        saveBtn.textContent = "Enregistrement...";
        editStatus.className = "edit-status-msg status-box hidden";

        try {
          const res = await fetch(`/api/comments/${commentId}`, {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ content: newText }),
          });

          const data = await res.json().catch(() => ({}));

          if (!res.ok) {
            throw new Error(data.erreur || data.message || "Erreur lors de la modification.");
          }

          bodyEl.textContent = newText;
          editBox.remove();
          bodyEl.style.display = "";
        } catch (err: any) {
          editStatus.textContent = err.message || "Erreur lors de la sauvegarde.";
          editStatus.className = "edit-status-msg status-box error";
          saveBtn.disabled = false;
          saveBtn.textContent = "Enregistrer";
        }
      });
    });

    deleteBtn?.addEventListener("click", async (e) => {
      e.stopPropagation();
      menuDropdown.classList.add("hidden");

      const commentId = cardEl.dataset.commentId;
      if (!commentId) return;

      const isTopLevel = cardEl.classList.contains("level-1");
      const confirmMsg = isTopLevel
        ? "Voulez-vous vraiment supprimer ce commentaire ainsi que ses réponses éventuelles ?"
        : "Voulez-vous vraiment supprimer cette réponse ?";

      if (!window.confirm(confirmMsg)) return;

      try {
        const res = await fetch(`/api/comments/${commentId}`, {
          method: "DELETE",
        });

        const data = await res.json().catch(() => ({}));

        if (!res.ok) {
          throw new Error(data.erreur || data.message || "Erreur lors de la suppression.");
        }

        if (isTopLevel) {
          const threadEl = cardEl.closest(".comment-thread") as HTMLElement;
          const repliesCount = threadEl ? threadEl.querySelectorAll(".level-2").length : 0;
          threadEl?.remove();
          updateCommentsCount(-(1 + repliesCount));
        } else {
          cardEl.remove();
          updateCommentsCount(-1);
        }

        if (list.children.length === 0) {
          const reinsertedEmpty = document.createElement("p");
          reinsertedEmpty.className = "empty-text";
          reinsertedEmpty.id = "empty-state";
          reinsertedEmpty.textContent = "Aucun commentaire pour le moment. Soyez le premier à donner votre avis !";
          list.appendChild(reinsertedEmpty);
        }
      } catch (err: any) {
        alert(err.message || "Impossible de supprimer le commentaire.");
      }
    });
  }

  function attachReplyListeners(threadEl: HTMLElement) {
    const replyTriggerBtn = threadEl.querySelector(".reply-trigger-btn") as HTMLButtonElement;
    const replyForm = threadEl.querySelector(".reply-form") as HTMLFormElement;
    const replyCancelBtn = threadEl.querySelector(".reply-cancel-btn") as HTMLButtonElement;
    const replyInput = threadEl.querySelector(".reply-input") as HTMLTextAreaElement;
    const replySubmitBtn = threadEl.querySelector(".reply-submit-btn") as HTMLButtonElement;
    const replyStatusMsg = threadEl.querySelector(".reply-status-msg") as HTMLSpanElement;
    const repliesList = threadEl.querySelector(".replies-list") as HTMLDivElement;

    if (!replyTriggerBtn || !replyForm) return;

    replyTriggerBtn.addEventListener("click", () => {
      const isHidden = replyForm.classList.contains("hidden");
      if (isHidden) {
        replyForm.classList.remove("hidden");
        replyInput?.focus();
      } else {
        replyForm.classList.add("hidden");
      }
    });

    replyCancelBtn?.addEventListener("click", () => {
      replyForm.classList.add("hidden");
      if (replyStatusMsg) {
        replyStatusMsg.className = "reply-status-msg status-box hidden";
        replyStatusMsg.textContent = "";
      }
    });

    replyForm.addEventListener("submit", async (e) => {
      e.preventDefault();

      if (!isAuthenticated) {
        window.location.href = "/login";
        return;
      }

      const parentId = replyForm.dataset.parentId;
      if (!parentId) return;

      const replyContent = replyInput.value.trim();
      if (!replyContent) return;

      if (replySubmitBtn) {
        replySubmitBtn.disabled = true;
        replySubmitBtn.textContent = "Envoi...";
      }
      if (replyStatusMsg) {
        replyStatusMsg.className = "reply-status-msg status-box hidden";
        replyStatusMsg.textContent = "";
      }

      // UI optimiste immédiate
      const optimisticReply = document.createElement("article");
      optimisticReply.className = "comment-card level-2 added";
      optimisticReply.innerHTML = `
        <div class="comment-top">
          <div class="author-badge">
            <span class="reply-tag">↳ Réponse</span>
            <strong>Vous</strong>
          </div>
          <div class="comment-top-right">
            <time>À l'instant</time>
          </div>
        </div>
        <p class="comment-body">${escapeHtml(replyContent)}</p>
      `;

      repliesList.appendChild(optimisticReply);
      updateCommentsCount(1);
      replyInput.value = "";

      try {
        const response = await fetch("/api/comments", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            book_id: bookId,
            content: replyContent,
            parent_id: Number(parentId),
          }),
        });

        const data = await response.json().catch(() => ({}));

        if (!response.ok) {
          throw new Error(data.message || data.erreur || "Erreur lors de l'envoi de la réponse.");
        }

        optimisticReply.dataset.commentId = String(data.id || "");
        optimisticReply.classList.remove("added");

        const topRight = optimisticReply.querySelector(".comment-top-right");
        if (topRight) {
          const menuWrapper = document.createElement("div");
          menuWrapper.className = "comment-menu-wrapper";
          menuWrapper.innerHTML = `
            <button type="button" class="comment-menu-btn" aria-label="Options de la réponse" title="Options">⋯</button>
            <div class="comment-menu-dropdown hidden">
              <button type="button" class="menu-item action-edit">✏️ Modifier</button>
              <button type="button" class="menu-item action-delete">🗑️ Supprimer</button>
            </div>
          `;
          topRight.appendChild(menuWrapper);
          attachMenuListeners(optimisticReply);
        }

        replyForm.reset();
        replyForm.classList.add("hidden");

        if (replyStatusMsg) {
          replyStatusMsg.textContent = "Réponse envoyée !";
          replyStatusMsg.className = "reply-status-msg status-box success";
          setTimeout(() => {
            replyStatusMsg.className = "reply-status-msg status-box hidden";
          }, 3000);
        }
      } catch (err: any) {
        // Rollback en cas d'erreur réseau
        optimisticReply.remove();
        updateCommentsCount(-1);

        replyInput.value = replyContent;

        if (replyStatusMsg) {
          replyStatusMsg.textContent = err.message || "Impossible d'envoyer la réponse.";
          replyStatusMsg.className = "reply-status-msg status-box error";
        }
      } finally {
        if (replySubmitBtn) {
          replySubmitBtn.disabled = false;
          replySubmitBtn.textContent = "Envoyer la réponse";
        }
      }
    });
  }

  document.querySelectorAll<HTMLElement>(".comment-thread").forEach((thread) => {
    attachReplyListeners(thread);
  });

  document.querySelectorAll<HTMLElement>(".comment-card").forEach((card) => {
    attachMenuListeners(card);
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    if (!isAuthenticated) {
      window.location.href = "/login";
      return;
    }

    const content = contentInput.value.trim();
    if (!content) return;

    submitBtn.disabled = true;
    submitBtn.textContent = "Envoi...";
    statusMsg.className = "status-box hidden";
    statusMsg.textContent = "";

    const emptyState = document.getElementById("empty-state");

    // UI optimiste immédiate
    const optimisticThread = document.createElement("div");
    optimisticThread.className = "comment-thread";
    optimisticThread.innerHTML = `
      <article class="comment-card level-1 added">
        <div class="comment-top">
          <div class="author-badge">
            <span class="avatar-icon">👤</span>
            <strong>Vous</strong>
          </div>
          <div class="comment-top-right">
            <time>À l'instant</time>
          </div>
        </div>
        <p class="comment-body">${escapeHtml(content)}</p>
        <div class="comment-actions">
          <button type="button" class="reply-trigger-btn" title="Répondre à ce commentaire">
            <span class="reply-icon">↩</span> Répondre
          </button>
        </div>
        <form class="reply-form hidden">
          <div class="field">
            <textarea class="reply-input" name="content" rows="2" placeholder="Écrivez votre réponse..." required></textarea>
          </div>
          <div class="reply-actions">
            <button type="submit" class="reply-submit-btn">Envoyer la réponse</button>
            <button type="button" class="reply-cancel-btn">Annuler</button>
            <span class="reply-status-msg status-box hidden"></span>
          </div>
        </form>
      </article>
      <div class="replies-list"></div>
    `;

    let emptyStateRemoved = false;
    if (emptyState) {
      emptyState.remove();
      emptyStateRemoved = true;
    }

    list.prepend(optimisticThread);
    updateCommentsCount(1);
    contentInput.value = "";

    try {
      const response = await fetch("/api/comments", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          book_id: bookId,
          content: content,
          parent_id: null,
        }),
      });

      const data = await response.json().catch(() => ({}));

      if (!response.ok) {
        throw new Error(data.message || data.erreur || "Erreur lors de l'ajout du commentaire.");
      }

      const newCommentId = data.id;
      optimisticThread.dataset.threadId = String(newCommentId);

      const articleEl = optimisticThread.querySelector(".comment-card.level-1") as HTMLElement;
      if (articleEl) {
        articleEl.dataset.commentId = String(newCommentId);
        articleEl.classList.remove("added");

        const topRight = articleEl.querySelector(".comment-top-right");
        if (topRight) {
          const menuWrapper = document.createElement("div");
          menuWrapper.className = "comment-menu-wrapper";
          menuWrapper.innerHTML = `
            <button type="button" class="comment-menu-btn" aria-label="Options du commentaire" title="Options">⋯</button>
            <div class="comment-menu-dropdown hidden">
              <button type="button" class="menu-item action-edit">✏️ Modifier</button>
              <button type="button" class="menu-item action-delete">🗑️ Supprimer</button>
            </div>
          `;
          topRight.appendChild(menuWrapper);
          attachMenuListeners(articleEl);
        }
      }

      const replyTrigger = optimisticThread.querySelector(".reply-trigger-btn") as HTMLElement;
      if (replyTrigger) replyTrigger.dataset.parentId = String(newCommentId);

      const replyFormEl = optimisticThread.querySelector(".reply-form") as HTMLElement;
      if (replyFormEl) replyFormEl.dataset.parentId = String(newCommentId);

      const repliesListEl = optimisticThread.querySelector(".replies-list") as HTMLElement;
      if (repliesListEl) repliesListEl.dataset.parentId = String(newCommentId);

      attachReplyListeners(optimisticThread);

      form.reset();
      statusMsg.textContent = "Commentaire publié avec succès !";
      statusMsg.className = "status-box success";
    } catch (err: any) {
      // Rollback en cas d'erreur réseau
      optimisticThread.remove();
      updateCommentsCount(-1);

      contentInput.value = content;

      if (emptyStateRemoved && list.children.length === 0) {
        const reinsertedEmpty = document.createElement("p");
        reinsertedEmpty.className = "empty-text";
        reinsertedEmpty.id = "empty-state";
        reinsertedEmpty.textContent = "Aucun commentaire pour le moment. Soyez le premier à donner votre avis !";
        list.appendChild(reinsertedEmpty);
      }

      statusMsg.textContent = err.message || "Une erreur est survenue lors de l'ajout du commentaire.";
      statusMsg.className = "status-box error";
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Envoyer mon commentaire";
    }
  });
</script>

<style is:global>
  .comment-thread {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .comment-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
    transition: border-color 0.15s ease;
  }

  .comment-card.level-1 {
    background-color: #ffffff;
  }

  .comment-card.added {
    border-color: #93c5fd;
    background-color: #f8fafc;
    animation: fadeIn 0.3s ease-out;
  }

  .comment-card.level-2 {
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 0.85rem 1rem;
    font-size: 0.95em;
  }

  .replies-list {
    margin-left: 1.75rem;
    padding-left: 1.25rem;
    border-left: 2px solid #cbd5e1;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .comment-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.88rem;
  }

  .author-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .author-badge strong {
    color: var(--text-primary);
  }

  .avatar-icon {
    font-size: 0.95rem;
    opacity: 0.8;
  }

  .reply-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: #475569;
    background-color: #e2e8f0;
