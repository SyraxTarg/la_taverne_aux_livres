---
// src/pages/search.astro
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import BookCardHorizontal from '../components/BookCardHorizontal.astro';
import { booksList } from '../data/books';

const ITEMS_PER_PAGE = 5;

const query = Astro.url.searchParams.get('q') || '';
const pageParam = Astro.url.searchParams.get('page');
const currentPage = Math.max(1, parseInt(pageParam || '1', 10) || 1);

const totalItems = booksList.length;
const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE) || 1;

const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
const endIndex = startIndex + ITEMS_PER_PAGE;
const results = booksList.slice(startIndex, endIndex);

const buildPageUrl = (targetPage: number) => {
  const params = new URLSearchParams();
  if (query) params.set('q', query);
  params.set('page', targetPage.toString());
  return `?${params.toString()}`;
};
---

<Layout pageTitle={`Recherche : "${query}"`}>
  <section class="search-header">
    <a href="/" class="back-link">← Retour à la bibliothèque</a>
    <h1>Résultats de recherche</h1>
    {query ? (
      <p class="search-subtitle">
        Résultats simulés pour la recherche : <mark>« {query} »</mark> ({totalItems} trouvés)
      </p>
    ) : (
      <p class="search-subtitle">
        Affichage de l'ensemble des livres de la taverne ({totalItems} trouvés).
      </p>
    )}
  </section>

  <section class="results-stack">
    {results.map((book) => (
      <BookCardHorizontal {book} />
    ))}
  </section>

  {totalPages > 1 && (
    <nav class="pagination" aria-label="Pagination des résultats">
      <a
        href={buildPageUrl(currentPage - 1)}
        class={`pagination-btn ${currentPage <= 1 ? 'disabled' : ''}`}
        aria-disabled={currentPage <= 1}
        tabindex={currentPage <= 1 ? -1 : undefined}
      >
        ← Précédent
      </a>

      <div class="pagination-pages">
        {Array.from({ length: totalPages }, (_, i) => i + 1).map((pageNum) => (
          <a
            href={buildPageUrl(pageNum)}
            class={`pagination-link ${pageNum === currentPage ? 'active' : ''}`}
            aria-current={pageNum === currentPage ? 'page' : undefined}
          >
            {pageNum}
          </a>
        ))}
      </div>

      <a
        href={buildPageUrl(currentPage + 1)}
        class={`pagination-btn ${currentPage >= totalPages ? 'disabled' : ''}`}
        aria-disabled={currentPage >= totalPages}
        tabindex={currentPage >= totalPages ? -1 : undefined}
      >
        Suivant →
      </a>
    </nav>
  )}
</Layout>

<style>
  .search-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .back-link {
    display: inline-block;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.88rem;
    margin-bottom: 0.75rem;
    transition: color 0.15s;
  }

  .back-link:hover {
    color: var(--accent-color);
  }

  .search-header h1 {
    font-size: 1.8rem;
    margin: 0 0 0.5rem 0;
  }

  .search-subtitle {
    font-size: 1rem;
    color: var(--text-secondary);
    margin: 0;
  }

  mark {
    background-color: var(--accent-light);
    color: var(--accent-hover);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-weight: 500;
  }

  .results-stack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
  }

  .pagination-pages {
    display: flex;
    gap: 0.5rem;
  }

  .pagination-link,
  .pagination-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    color: var(--text-primary, inherit);
    background: var(--bg-card, #fff);
    font-size: 0.9rem;
    transition: all 0.2s ease;
  }

  .pagination-btn {
    padding: 0.4rem 0.85rem;
  }

  .pagination-link {
    width: 2.25rem;
    height: 2.25rem;
  }

  .pagination-link:hover:not(.active),
  .pagination-btn:hover:not(.disabled) {
    border-color: var(--accent-color);
    color: var(--accent-color);
  }

  .pagination-link.active {
    background-color: var(--accent-color);
    border-color: var(--accent-color);
    color: #fff;
    font-weight: bold;
    cursor: default;
  }

  .pagination-btn.disabled {
    opacity: 0.4;
    pointer-events: none;
    cursor: not-allowed;
  }
</style>