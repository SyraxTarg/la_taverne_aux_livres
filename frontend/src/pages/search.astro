---
// src/pages/search.astro
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import BookCardHorizontal from '../components/BookCardHorizontal.astro';
import Pagination from '../components/Pagination.astro';
import { API_URL } from 'astro:env/server';
import type { ApiBook, ApiPagination } from '../data/books';

const ITEMS_PER_PAGE = 5;

const query = Astro.url.searchParams.get('q') || '';
const pageParam = Astro.url.searchParams.get('page');
const currentPage = Math.max(1, parseInt(pageParam || '1', 10) || 1);

const apiUrl = new URL(`${API_URL}/books`);
if (query) {
  apiUrl.searchParams.set('recherche', query);
}
apiUrl.searchParams.set('limit', String(ITEMS_PER_PAGE));
apiUrl.searchParams.set('offset', String((currentPage - 1) * ITEMS_PER_PAGE));

let booksList: ApiBook[] = [];
let pagination: ApiPagination | null = null;

try {
  const response = await fetch(apiUrl.toString());
  if (response.ok) {
    const booksListJson = await response.json();
    booksList = booksListJson.livres ?? [];
    pagination = booksListJson.pagination ?? null;
  } else {
    console.error(`Erreur API (${response.status}):`, await response.text());
  }
} catch (error) {
  console.error('Erreur lors de la récupération des livres :', error);
}

const totalItems = pagination ? pagination.total_items : booksList.length;
const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE) || 1;
---

<Layout pageTitle={`Recherche : "${query}"`}>
  <section class="search-header">
    <a href="/" class="back-link">← Retour à la bibliothèque</a>
    <h1>Résultats de recherche</h1>
    {query ? (
      <p class="search-subtitle">
        Résultats simulés pour la recherche : <mark>« {query} »</mark> ({totalItems} trouvés)
      </p>
    ) : (
      <p class="search-subtitle">
        Affichage de l'ensemble des livres de la taverne ({totalItems} trouvés).
      </p>
    )}
  </section>

  <section class="results-stack">
    {booksList.map((book) => (
      <BookCardHorizontal {book} />
    ))}
  </section>

  <Pagination
    currentPage={currentPage}
    totalPages={totalPages}
    baseQuery={query}
  />
</Layout>

<style>
  .search-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .back-link {
    display: inline-block;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.88rem;
    margin-bottom: 0.75rem;
    transition: color 0.15s;
  }

  .back-link:hover {
    color: var(--accent-color);
  }

  .search-header h1 {
    font-size: 1.8rem;
    margin: 0 0 0.5rem 0;
  }

  .search-subtitle {
    font-size: 1rem;
    color: var(--text-secondary);
    margin: 0;
  }

  mark {
    background-color: var(--accent-light);
    color: var(--accent-hover);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-weight: 500;
  }

  .results-stack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
</style>