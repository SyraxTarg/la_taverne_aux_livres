---
// src/pages/index.astro
import TavernLayout from '../layouts/TavernLayout.astro';
import BookCard from '../components/BookCard.astro';
import { booksList } from '../data/books';
---

<TavernLayout pageTitle="Bibliothèque">
  <section class="intro">
    <h1>La Taverne aux Livres</h1>
    <p>Sélection de livres lus, avis personnels et recommandations.</p>
  </section>

  <div class="list-head">
    <h2>Tous les livres ({booksList.length})</h2>
  </div>

  <section class="books-grid">
    {booksList.map((book) => (
      <BookCard {book} />
    ))}
  </section>
</TavernLayout>

<style>
  .intro {
    padding-bottom: 2rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-color);
  }

  .intro h1 {
    font-size: 2rem;
    margin: 0 0 0.4rem 0;
  }

  .intro p {
    font-size: 1.05rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .list-head {
    margin-bottom: 1.25rem;
  }

  .list-head h2 {
    font-size: 1.2rem;
    margin: 0;
  }

  .books-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 1.5rem;
  }
</style>