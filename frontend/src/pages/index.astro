---
// src/pages/index.astro
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import BookCard from '../components/BookCard.astro';
import { API_URL } from 'astro:env/server';
import type { ApiBook } from '../data/books';

const BOOK_DISPLAYED_LIMIT = 9;

let booksList = [];

try {
  const apiUrl = new URL(`${API_URL}/books`);
  apiUrl.searchParams.set('limit', String(BOOK_DISPLAYED_LIMIT));

  const response = await fetch(apiUrl);
  if (response.ok) {
    const booksListJson = await response.json();
    booksList = booksListJson.livres
  } else {
    console.error(`Erreur API : ${response.status}`);
  }
} catch (error) {
  console.error('Impossible de joindre l\'API :', error);
}
---

<Layout pageTitle="Bibliothèque">
  <section class="intro">
    <h1>La Taverne aux Livres</h1>
    <p>Sélection de livres lus, avis personnels et recommandations.</p>
  </section>

  <div class="list-head">
    <h2>Sélection de livres du jour</h2>
  </div>

  <section class="books-grid">
    {booksList.map((book : ApiBook) => (
      <BookCard {book} />
    ))}
  </section>
</Layout>

<style>
  .intro {
    padding-bottom: 2rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-color);
  }

  .intro h1 {
    font-size: 2rem;
    margin: 0 0 0.4rem 0;
  }

  .intro p {
    font-size: 1.05rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .list-head {
    margin-bottom: 1.25rem;
  }

  .list-head h2 {
    font-size: 1.2rem;
    margin: 0;
  }

  .books-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 1.5rem;
  }
</style>