---
// src/pages/register.astro
import Layout from '../layouts/Layout.astro';
import { API_URL } from 'astro:env/server';

export const prerender = false;

let errorMessage = '';
let successMessage = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const email = String(formData.get('email') || '').trim();
    const password = String(formData.get('password') || '');

    // Validation simple
    const isValidEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    const isValidPassword = password.length >= 8 && /\d/.test(password) && /[A-Z]/.test(password);

    if (!isValidEmail) {
      errorMessage = "Format d'adresse email invalide.";
    } else if (!isValidPassword) {
      errorMessage = 'Le mot de passe doit comporter au moins 8 caractères, dont une majuscule et un chiffre.';
    } else {
      const response = await fetch(`${API_URL}/auth/register`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password, role_id: 2 }),
      });

      const data = await response.json();

      if (!response.ok) {
        errorMessage = data.message || "Échec de l'inscription";
      } else {
        return Astro.redirect('/login');
      }
    }
  } catch (err: any) {
    errorMessage = err.message;
  }
}
---

<Layout pageTitle="Inscription - La Taverne aux Livres">
  <div class="auth-container">
    <h1>Créer un compte</h1>
    
    {errorMessage && <div class="alert error">{errorMessage}</div>}
    {successMessage && <div class="alert success">{successMessage}</div>}

    <!-- Formulaire HTML standard en méthode POST sans fetch JS -->
    <form method="POST">
      <div class="form-group">
        <label for="email">Adresse email</label>
        <input type="email" id="email" name="email" required autocomplete="email" />
      </div>

      <div class="form-group">
        <label for="password">Mot de passe</label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          required 
          autocomplete="new-password"
        />
        <small class="hint">Min. 8 caractères, 1 chiffre, 1 majuscule.</small>
      </div>

      <button type="submit">S'inscrire</button>
    </form>

    <p class="auth-switch">
      Déjà inscrit ? <a href="/login">Se connecter</a>
    </p>
  </div>
</Layout>

<style>
  .auth-container {
    max-width: 400px;
    margin: 3rem auto;
    padding: 2rem;
    border: 1px solid var(--border-color, #e2e8f0);
    border-radius: 8px;
    background: var(--bg-card, #ffffff);
  }

  h1 {
    font-size: 1.6rem;
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    margin-bottom: 1.2rem;
  }

  label {
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 0.35rem;
  }

  input {
    padding: 0.6rem 0.8rem;
    font-size: 1rem;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
  }

  .hint {
    margin-top: 0.35rem;
    font-size: 0.75rem;
    color: #64748b;
  }

  button {
    width: 100%;
    padding: 0.75rem;
    font-size: 1rem;
    font-weight: 600;
    background: #2563eb;
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    margin-top: 0.5rem;
  }

  button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .alert {
    padding: 0.75rem;
    border-radius: 4px;
    margin-bottom: 1rem;
    font-size: 0.9rem;
  }

  .alert.error {
    background-color: #fee2e2;
    color: #991b1b;
  }

  .alert.success {
    background-color: #dcfce7;
    color: #166534;
  }

  .auth-switch {
    margin-top: 1.5rem;
    text-align: center;
    font-size: 0.9rem;
  }
</style>