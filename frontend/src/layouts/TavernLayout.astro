---
// src/layouts/TavernLayout.astro
interface Props {
  pageTitle: string;
}

const { pageTitle } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle} — La Taverne aux Livres</title>
  </head>
  <body>
    <header class="navbar">
      <div class="container nav-content">
        <a href="/" class="brand">
          <span class="brand-badge">📖</span>
          <span class="brand-title">La Taverne aux Livres</span>
        </a>

        <nav class="nav-links">
          <a href="/" class="nav-link active">Bibliothèque</a>
        </nav>
      </div>
    </header>

    <main class="container main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>© 2026 La Taverne aux Livres — Carnet de lecture personnel</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg-page: #f8fafc;
    --bg-card: #ffffff;
    --bg-input: #ffffff;
    --bg-hover: #f1f5f9;

    --text-primary: #0f172a;
    --text-secondary: #475569;
    --text-muted: #94a3b8;

    --border-color: #e2e8f0;
    --border-hover: #cbd5e1;

    --accent-color: #d97706;
    --accent-hover: #b45309;
    --accent-light: #fef3c7;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    background-color: var(--bg-page);
    color: var(--text-primary);
    line-height: 1.6;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  h1, h2, h3, h4 {
    color: var(--text-primary);
    font-weight: 600;
  }
</style>

<style>
  .container {
    max-width: 1020px;
    margin: 0 auto;
    padding: 0 1.5rem;
    width: 100%;
  }

  .navbar {
    background-color: #ffffff;
    border-bottom: 1px solid var(--border-color);
    position: sticky;
    top: 0;
    z-index: 30;
  }

  .nav-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 60px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--text-primary);
    font-weight: 600;
    font-size: 1.05rem;
  }

  .brand-badge {
    font-size: 1.2rem;
  }

  .nav-links {
    display: flex;
    gap: 1.25rem;
  }

  .nav-link {
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: color 0.15s;
  }

  .nav-link:hover, .nav-link.active {
    color: var(--text-primary);
  }

  .main-content {
    flex-grow: 1;
    padding-top: 2.5rem;
    padding-bottom: 4rem;
  }

  .site-footer {
    border-top: 1px solid var(--border-color);
    background-color: #ffffff;
    padding: 1.5rem 0;
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
</style>