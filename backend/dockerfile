# ==========================================
# Étape 1 : Construction (Builder)
# ==========================================
FROM rust:1-slim-bookworm AS builder

WORKDIR /app

# Dépendances nécessaires à la compilation (OpenSSL, curl pour Swagger UI, build-essential pour g++/libstdc++ requis par ONNX/FastEmbed)
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    curl \
    ca-certificates \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Mise en cache des dépendances Cargo
COPY Cargo.toml Cargo.lock ./

# Projet factice pour compiler et mettre en cache uniquement les dépendances
RUN mkdir src && echo "fn main() {}" > src/main.rs
RUN cargo build --release
RUN rm -rf src

# Copie des véritables sources
COPY src ./src

# Mise à jour du timestamp pour forcer cargo à recompiler le binaire avec le vrai code
RUN touch src/main.rs && cargo build --release

# ==========================================
# Étape 2 : Image finale d'exécution (Runtime)
# ==========================================
FROM debian:bookworm-slim AS runner

WORKDIR /app

# Installation des certificats CA, de libssl et de la lib C++ (libstdc++6) pour ONNX/FastEmbed
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

# Sécurité : création de l'utilisateur non-root
RUN useradd -m -u 1001 appuser

# Variables d'environnement pour l'utilisateur et le cache FastEmbed / HuggingFace
ENV HOME=/home/appuser
ENV FASTEMBED_CACHE_DIR=/home/appuser/.fastembed_cache
ENV HF_HOME=/home/appuser/.cache/huggingface
ENV HOST=0.0.0.0
ENV PORT=3000

# Création des dossiers de cache avec les bonnes permissions
RUN mkdir -p /home/appuser/.fastembed_cache /home/appuser/.cache \
    && chown -R appuser:appuser /app /home/appuser

# Copie du binaire compilé depuis le builder avec attribution à appuser
COPY --from=builder --chown=appuser:appuser /app/target/release/backend /app/backend

USER appuser

# Port exposé
EXPOSE 3000

# Commande de lancement
CMD ["/app/backend"]

